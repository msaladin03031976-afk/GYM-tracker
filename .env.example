# Copy this file to .env and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# The public web address of the app (used for password-reset links).
# Use your Vercel URL once deployed, e.g. https://gym-tracker.vercel.app
VITE_SITE_URL=http://localhost:5173
